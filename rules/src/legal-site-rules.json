{
	"segments": [
		{
			"id": "entered_legal_site_from_google",
			"combinator": "and",
			"rules": [
				{
					"attr": "referrer",
					"op": "matches",
					"val": ".*/external/google.*"
				}
			],
			"retention": "SESSION"
		},
		{
			"id": "eligible_for_review",
			"combinator": "and",
			"rules": [
				{
					"attr": "audiences",
					"op": "include",
					"val": "entered_legal_site_from_google"
				}
			],
			"retention": "PAGE"
		}
	]
}
