{
	"segments": [
		{
			"id": "entered_legal_site_from_google",
			"rule": {
				"attr": "referrer",
				"op": "matches",
				"val": ".*/external/google.*"
			},
			"retention": "SESSION"
		},
		{
			"id": "eligible_for_review",
			"rule": {
				"attr": "audiences",
				"op": "include",
				"val": "entered_legal_site_from_google"
			},
			"retention": "PAGE"
		}
	]
}
