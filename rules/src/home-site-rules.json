{
	"segments": [
		{
			"id": "late_night_surfer",
			"rule": {
				"attr": "local_hour",
				"op": "between",
				"val": [
					4,
					5
				]
			},
			"retention": "SESSION"
		},
		{
			"id": "english_language",
			"rule": {
				"attr": "browser_language",
				"op": "eq",
				"val": "en-US"
			},
			"retention": "PAGE"
		},
		{
			"id": "spanish_language",
			"rule": {
				"attr": "browser_language",
				"op": "eq",
				"val": "es-ES"
			},
			"retention": "PAGE"
		}
	]
}
