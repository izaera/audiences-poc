{
	"audiences": [
		{
			"id": "late_night_surfer",
			"combinator": "and",
			"rules": [
				{
					"attr": "local_hour",
					"op": "between",
					"val": [
						4,
						5
					]
				}
			],
			"retention": "BROWSER"
		},
		{
			"id": "english_language",
			"combinator": "and",
			"rules": [
				{
					"attr": "browser_language",
					"op": "eq",
					"val": "en-US"
				}
			],
			"retention": "PAGE"
		},
		{
			"id": "spanish_language",
			"combinator": "and",
			"rules": [
				{
					"attr": "browser_language",
					"op": "eq",
					"val": "es-ES"
				}
			],
			"retention": "PAGE"
		},
		{
			"id": "entered_legal_site_from_google",
			"combinator": "and",
			"rules": [
				{
					"attr": "referrer",
					"op": "matches",
					"val": ".*/external/google.*"
				},
				{
					"combinator": "or",
					"rules": [
						{
							"attr": "pathname",
							"op": "eq",
							"val": "/legal-site/about"
						},
						{
							"attr": "pathname",
							"op": "eq",
							"val": "/legal-site/contact"
						}
					]
				}
			],
			"retention": "BROWSER"
		},
		{
			"id": "entered_shopping_site_from_google",
			"combinator": "and",
			"rules": [
				{
					"attr": "referrer",
					"op": "matches",
					"val": ".*/external/google.*"
				},
				{
					"attr": "pathname",
					"op": "eq",
					"val": "/shopping-site/products"
				}
			],
			"retention": "BROWSER"
		}
	]
}

